
{
  "name": "DisableUser_AD",
  "version": "1.0",
  "author": "Jochy Mendez",
  "url": "https://github.com/jochymendez/blue-team-lab",
  "license": "AGPL-V3",
  "description": "Disable an Active Directory user account via WinRM remote PowerShell",
  "dataTypeList": ["thehive:case_artifact", "other", "mail", "username"],
  "command": "DisableUser_AD/DisableUser_AD.py",
  "dockerImage": "cortexneurons/disableuser_ad:1.0",
  "baseConfig": "WindowsResponder",
  "config": {
    "check_tlp": true,
    "max_tlp": 3,
    "check_pap": true,
    "max_pap": 3
  },
  "configurationItems": [
    {
      "name": "dc_host",
      "description": "DC hostname or IP",
      "type": "string",
      "multi": false,
      "required": true,
      "defaultValue": "10.10.10.10"
    },
    {
      "name": "dc_port",
      "description": "WinRM port",
      "type": "number",
      "multi": false,
      "required": true,
      "defaultValue": 5985
    },
    {
      "name": "svc_username",
      "description": "Service account username (UPN format recommended)",
      "type": "string",
      "multi": false,
      "required": true,
      "defaultValue": "svc-soc-automation"
    },
    {
      "name": "svc_password",
      "description": "Service account password",
      "type": "string",
      "multi": false,
      "required": true,
      "defaultValue": ""
    },
    {
      "name": "protected_users",
      "description": "Comma-separated usernames that must NEVER be disabled (safety list)",
      "type": "string",
      "multi": false,
      "required": true,
      "defaultValue": "Administrator,krbtgt,svc-soc-automation"
    }
  ]
}
