```
# Custom Cortex image with Python runtime pre-installed
# for custom analyzers (OllamaForensics, etc) and responders (BlockIP_Windows, DisableUser_AD)
# Base: official Cortex 4.1.0 from TheHive Project
#
# Build:
#   docker build -t cortex-custom:4.1.0-jochy .
#
# Use in docker-compose.yml:
#   cortex:
#     image: "cortex-custom:4.1.0-jochy"

FROM thehiveproject/cortex:4.1.0

USER root

# Install Python 3 + pip + venv support
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        python3-venv \
    && rm -rf /var/lib/apt/lists/*

# Install Python libs required by custom analyzers/responders
# --break-system-packages needed because Debian 12 PEP 668
RUN pip3 install --break-system-packages --no-cache-dir \
        cortexutils \
        requests

# Verify installation at build time (fail-fast principle)
RUN python3 -c "import cortexutils, requests; print('Python runtime ready for Cortex analyzers')"

# Return to Cortex upstream user
USER 1001

LABEL maintainer="Jochy Mendez"
LABEL description="Cortex 4.1.0 extended with Python runtime for custom LLM analyzers and SOAR responders"
```
