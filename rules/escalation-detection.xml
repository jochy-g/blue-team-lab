<!--
  Custom Wazuh rules for bloodhound detection
  
  Deploy: append to /var/ossec/etc/rules/local_rules.xml
  Restart: sudo systemctl restart wazuh-manager
  
  Author: Jochy Mendez
  Date: 2026-09-03
-->

<group name="windows,ad_attack,escalation,custom_jochy">

  <!-- 100300: Password reset by non-admin user -->
  <!-- 100300: Password/account change detection - broader coverage -->
<rule id="100300" level="10">
  <if_sid>60103,60204</if_sid>
  <field name="win.system.eventID">^4724$|^4738$|^4723$</field>
  <description>Account modification event $(win.system.eventID) - user $(win.eventdata.targetUserName) modified by $(win.eventdata.subjectUserName)</description>
  <mitre>
    <id>T1098</id>
  </mitre>
  <group>account_manipulation,credential_access,</group>
</rule>

 <!-- 100301: User added to Domain Admins or high-privilege groups -->
<rule id="100301" level="14">
  <if_sid>60103,60204</if_sid>
  <field name="win.system.eventID">^4728$|^4732$|^4756$</field>
  <field name="win.eventdata.targetUserName">Domain Admins|Enterprise Admins|Schema Admins|Administrators</field>
  <description>CRITICAL: User $(win.eventdata.memberName) added to privileged group $(win.eventdata.targetUserName) by $(win.eventdata.subjectUserName)</description>
  <mitre>
    <id>T1484.001</id>
    <id>T1078.002</id>
  </mitre>
  <group>privilege_escalation,attack_pattern,critical,</group>
</rule>

  <!-- 100302: Full escalation chain detected (password reset + priv group add same day) -->
  <rule id="100302" level="15" frequency="1" timeframe="3600">
    <if_matched_sid>100300</if_matched_sid>
    <if_sid>100301</if_sid>
    <description>ATTACK CHAIN DETECTED: Password reset followed by privileged group addition within 1 hour - probable AD compromise</description>
    <mitre>
      <id>T1484.001</id>
      <id>T1098</id>
    </mitre>
    <group>attack_pattern,critical,domain_compromise,</group>
  </rule>

</group>
