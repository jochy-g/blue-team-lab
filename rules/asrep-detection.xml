<group name="windows,kerberos,asrep,custom_jochy">

  <!--   Custom Wazuh rules for as-rep detection (MITRE T1558.004)
  
  Developed to address gap in Wazuh 4.9 default detection where
  individual 4769 events at rule.level <= 3 are filtered below
  log_alert_level (default: 3), hiding the attack pattern from
  dashboard.
  
  Deploy: append to /var/ossec/etc/rules/local_rules.xml
  Restart: sudo systemctl restart wazuh-manager
  
  Author: Jochy Mendez
  Date: 2026-10-12 -->

<rule id="100400" level="5">
  <if_sid>60103,60204</if_sid>
  <field name="win.system.eventID">^4768$</field>
  <description>Windows: A Kerberos authentication ticket (TGT) was requested - Event 4768</description>
  <mitre>
    <id>T1558</id>
    <id>T1558.004</id>
  </mitre>
  <group>kerberos,credential_access,asrep_roasting</group>
</rule>

<rule id="100402" level="12" frequency="5" timeframe="60">
  <if_matched_sid>100400</if_matched_sid>
  <same_field>win.eventdata.ipAddress</same_field>
  <description> AS-REP Roasting attack detected: burst coming from $(win.eventdata.ipAddress)</description>
  <mitre>
    <id>T1558.004</id>
  </mitre>
  <group>asrep_roasting,attack_pattern,</group>
</rule>

</group>
