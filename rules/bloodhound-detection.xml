<!--
  Custom Wazuh rules for bloodhound detection
  
  Deploy: append to /var/ossec/etc/rules/local_rules.xml
  Restart: sudo systemctl restart wazuh-manager
  
  Author: Jochy Mendez
  Date: 2026-08-27
-->
<group name="windows,ldap,recon,custom_jochy">

  <!-- 100200: Baseline visibility for LDAP directory access -->
  <rule id="100200" level="5">
    <if_sid>60103,60204</if_sid>
    <field name="win.system.eventID">^4662$</field>
    <description>LDAP directory access on Active Directory (custom baseline)</description>
    <mitre>
      <id>T1087.002</id>
    </mitre>
    <group>ldap,directory_access,</group>
  </rule>

  <!-- 100201: LDAP query burst — SharpHound / BloodHound pattern -->
  <rule id="100201" level="10" frequency="50" timeframe="60">
    <if_matched_sid>100200</if_matched_sid>
    <same_field>win.eventdata.subjectUserName</same_field>
    <description>Possible AD enumeration (SharpHound-like): burst of LDAP queries from user $(win.eventdata.subjectUserName)</description>
    <mitre>
      <id>T1087.002</id>
      <id>T1069.002</id>
      <id>T1482</id>
    </mitre>
    <group>ad_recon,discovery,</group>
  </rule>

  <!-- 100202: Sustained enumeration burst — attack pattern -->
  <rule id="100202" level="12" frequency="200" timeframe="120">
    <if_matched_sid>100200</if_matched_sid>
    <same_field>win.eventdata.subjectUserName</same_field>
    <description>Sustained AD enumeration attack from user $(win.eventdata.subjectUserName) - possible BloodHound / SharpHound collection</description>
    <mitre>
      <id>T1087.002</id>
      <id>T1069.002</id>
      <id>T1018</id>
      <id>T1482</id>
    </mitre>
    <group>ad_recon,attack_pattern,discovery,</group>
  </rule>

</group>
